<?xml version="1.0" encoding="UTF-8"?>
<!--
  VetSalud ERP · configuración de Logback
  - CONSOLA:    eventos INFO o superiores para el operador.
  - ARCHIVO:    log técnico completo (DEBUG del sistema), rotación diaria/10 MB y compresión .gz.
  - ERRORES:    solo WARN y ERROR con traza completa (RNF-16).
  - AUDITORIA:  logger dedicado para operaciones críticas, conservado 24 meses (RF-04, RNF-06).
  - %msgSeguro: enmascara DNI, correos, teléfonos y contraseñas antes de escribir (RNF-15).
-->
<configuration>

  <conversionRule conversionWord="msgSeguro" class="pe.vetsalud.erp.log.MascaraDatosSensibles"/>

  <property name="LOG_DIR" value="${vetsalud.logdir:-logs}"/>
  <property name="PATRON"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{idSolicitud:-sistema}] [%X{usuario:-anonimo}] %logger{30} - %msgSeguro%n"/>

  <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>INFO</level>
    </filter>
    <encoder>
      <!-- %nopex: la traza completa solo va a errores.log, no a la pantalla -->
      <pattern>%d{HH:mm:ss} %-5level [%X{usuario:-anonimo}] %logger{20} - %msgSeguro%n%nopex</pattern>
    </encoder>
  </appender>

  <appender name="ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/vetsalud.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/historico/vetsalud-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>10MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>${PATRON}</pattern>
    </encoder>
  </appender>

  <!-- Escritura asíncrona: el registro no retrasa la respuesta al usuario (RNF-01) -->
  <appender name="ARCHIVO_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>512</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <appender-ref ref="ARCHIVO"/>
  </appender>

  <appender name="ERRORES" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>WARN</level>
    </filter>
    <file>${LOG_DIR}/errores.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/historico/errores-%d{yyyy-MM}.log.gz</fileNamePattern>
      <maxHistory>12</maxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>${PATRON}%ex{full}</pattern>
    </encoder>
  </appender>

  <appender name="AUDITORIA" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/auditoria.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/historico/auditoria-%d{yyyy-MM}.log.gz</fileNamePattern>
      <maxHistory>24</maxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}|%X{idSolicitud:-sistema}|%X{usuario:-anonimo}|%X{rol:--}|%msgSeguro%n</pattern>
    </encoder>
  </appender>

  <logger name="AUDITORIA" level="INFO" additivity="false">
    <appender-ref ref="AUDITORIA"/>
    <appender-ref ref="CONSOLA"/>
  </logger>

  <logger name="pe.vetsalud" level="DEBUG"/>
  <logger name="org.apache.poi" level="WARN"/>
  <logger name="org.postgresql" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="CONSOLA"/>
    <appender-ref ref="ARCHIVO_ASYNC"/>
    <appender-ref ref="ERRORES"/>
  </root>
</configuration>
