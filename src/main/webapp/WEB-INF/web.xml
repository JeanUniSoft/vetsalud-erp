<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
  <display-name>VetSalud ERP</display-name>

  <!-- RNF-05: la sesión expira tras 15 minutos de inactividad -->
  <session-config>
    <session-timeout>15</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
      <!-- en producción con HTTPS (RNF-04) se activa: <secure>true</secure> -->
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <jsp-config>
    <jsp-property-group>
      <url-pattern>*.jsp</url-pattern>
      <url-pattern>*.jspf</url-pattern>
      <page-encoding>UTF-8</page-encoding>
      <trim-whitespace>true</trim-whitespace>
    </jsp-property-group>
  </jsp-config>

  <welcome-file-list>
    <welcome-file>panel</welcome-file>
  </welcome-file-list>

  <!-- Nunca se muestran trazas al usuario (RNF-16) -->
  <error-page>
    <error-code>403</error-code>
    <location>/WEB-INF/jsp/error/sin-permiso.jsp</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/WEB-INF/jsp/error/no-encontrado.jsp</location>
  </error-page>
  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/WEB-INF/jsp/error/error.jsp</location>
  </error-page>
</web-app>
